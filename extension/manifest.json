{
  "manifest_version": 3,
  "name": "PhishGuard AI Extension",
  "version": "1.0.0",
  "description": "Real-time phishing detection with AI scoring.",
  "permissions": ["tabs", "notifications", "storage", "scripting"],
  "host_permissions": ["<all_urls>", "http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PhishGuard AI",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
